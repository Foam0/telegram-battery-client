{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache_socks.db"
    },
    "debug": {
      "gc_percent": 200
    }
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "bootstrap-dns",
        "server": "1.1.1.1",
        "server_port": 53
      },
      {
        "type": "https",
        "tag": "remote-dns",
        "server": "cloudflare-dns.com",
        "server_port": 443,
        "path": "/dns-query",
        "detour": "proxy",
        "domain_resolver": {
          "server": "bootstrap-dns",
          "strategy": "prefer_ipv4"
        }
      }
    ],
    "final": "remote-dns",
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 2080,
      "users": [
        {
          "username": "tg-local",
          "password": "sample-password"
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "vless",
      "tag": "proxy",
      "server": "203.0.113.10",
      "server_port": 443,
      "uuid": "bf000d23-0752-40b4-affe-68f7707a9661",
      "flow": "xtls-rprx-vision",
      "packet_encoding": "xudp",
      "domain_resolver": {
        "server": "bootstrap-dns",
        "strategy": "prefer_ipv4"
      },
      "tls": {
        "enabled": true,
        "server_name": "example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "jNXHt1yRo0vDuchQlIP6Z0ZvjT3KtzVI-T4E7RoLJS0",
          "short_id": "0123456789abcdef"
        }
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [],
    "final": "proxy",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "bootstrap-dns",
      "strategy": "prefer_ipv4"
    }
  }
}
